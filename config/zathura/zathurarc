map C toggle_continuous

# Press 'a' to force width alignment and center the view instantly
map a adjust_window width

# Press 's' to fit the full page cleanly inside the window boundaries
map s adjust_window best-fit


set sandbox none
set statusbar-h-padding 0
set statusbar-v-padding 0
set page-padding 1
set selection-clipboard clipboard

set default-bg "#555555"

set recolor-keephue
set recolor-lightcolor "#282828"
set recolor-darkcolor "#ebdbb2"


set recolor true
set scroll-step 1
set scroll-hstep 1
# Maps Control + Command + F to toggle fullscreen mode
set notification-bg "#232323" 
set notification-fg "#DDDDDD"
map <C-f> toggle_fullscreen
map [fullscreen] <C-f> toggle_fullscreen
map [fullscreen] <C-f> toggle_fullscreen
map [fullscreen] , zoom out
map [fullscreen] . zoom in

set statusbar-bg "#282828"
set statusbar-fg "#8ec07c"
set completion-bg "#282828"
set completion-fg "#8ec07c"
set completion-highlight-bg "#add8e6"
set inputbar-bg "#282828"
set inputbar-fg "#8ec07c"
set selection-notification false


map u scroll half-up
map d scroll half-down
map D toggle_page_mode
map r reload
map R rotate
map K zoom in
map J zoom out
map i recolor
map C toggle_continuous

